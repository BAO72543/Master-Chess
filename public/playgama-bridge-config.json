{
  "advertisement": {
    "minimumDelayBetweenInterstitial": 60,
    "initialInterstitialDelay": 0,
    "interstitial": {
      "disable": false,
      "placementFallback": "game_over",
      "placements": [
        {
          "id": "game_over"
        },
        {
          "id": "return_to_menu"
        },
        {
          "id": "sidebar_click"
        },
        {
          "id": "test_placement"
        }
      ]
    },
    "rewarded": {
      "disable": false
    },
    "banner": {
      "disable": false,
      "placementFallback": "main_menu",
      "placements": [
        {
          "id": "main_menu"
        },
        {
          "id": "pause_menu"
        },
        {
          "id": "game_over"
        },
        {
          "id": "test_placement"
        }
      ]
    },
    "advancedBanners": {
      "disable": false,
      "placementFallback": "main_menu",
      "main_menu": {
        "action": "show",
        "default": [
          { "width": "100%", "height": "8%", "bottom": "0%", "left": "0%" }
        ],
        "mobile:portrait": [
          { "width": "100%", "height": "8%", "bottom": "0%", "left": "0%" }
        ],
        "desktop:landscape": [
          { "width": "18%", "height": "16%", "bottom": "2%", "right": "2%" }
        ]
      },
      "level_started": {
        "action": "hide"
      },
      "level_paused": {
        "action": "show",
        "default": [
          { "width": "100%", "height": "8%", "bottom": "0%", "left": "0%" }
        ]
      },
      "pause_menu": {
        "action": "show",
        "default": [
          { "width": "100%", "height": "8%", "bottom": "0%", "left": "0%" }
        ]
      },
      "game_over": {
        "action": "show",
        "default": [
          { "width": "100%", "height": "8%", "bottom": "0%", "left": "0%" }
        ]
      },
      "level_resumed": {
        "action": "hide"
      },
      "gameplay_started": {
        "action": "hide"
      }
    }
  },
  "leaderboards": [
    {
      "id": "main"
    }
  ]
}
